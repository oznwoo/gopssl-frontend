{
  "expo": {
    "name": "Gopssl",
    "slug": "Gopssl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oznwoo.gopssl"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4EDFA"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.oznwoo.gopssl"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F4EDFA"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "82c3d916-4c90-4714-8c1b-4584e49965d8"
      }
    }
  }
}
